{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eksamio.ru/schemas/mastery-inference/0.1.0",
  "title": "Eksamio subject-agnostic mastery inference output",
  "description": "Recomputable inference output over accepted learner evidence. It is not a raw correct-rate, product flag, Tutor opinion, or client-authored truth.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "learner_profile_id", "subject_id", "semantic_id", "semantic_registry_version", "mastery", "system_inference", "evidence_summaries", "inference_version", "evidence_position", "computed_at"],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "learner_profile_id": {"type": "string", "minLength": 3},
    "subject_id": {"type": "string", "minLength": 2},
    "semantic_id": {"type": "string", "minLength": 3},
    "semantic_registry_version": {"type": "string", "minLength": 1},
    "mastery": {"$ref": "#/$defs/mastery"},
    "system_inference": {"$ref": "#/$defs/system_inference"},
    "learner_self_confidence_summary": {"$ref": "#/$defs/learner_self_confidence"},
    "evidence_summaries": {"$ref": "#/$defs/evidence_summaries"},
    "inference_version": {"type": "string", "minLength": 1},
    "evidence_position": {"$ref": "#/$defs/evidence_position"},
    "computed_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "mastery": {
      "type": "object", "additionalProperties": false,
      "required": ["estimate", "band", "status"],
      "properties": {
        "estimate": {"type": ["number", "null"], "minimum": 0, "maximum": 1, "description": "Optional model estimate; consumer-facing decisions may use band/status rather than false precision."},
        "band": {"enum": ["NOT_ESTABLISHED", "EMERGING", "DEVELOPING", "ESTABLISHED", "STRONG", "null"]},
        "status": {"enum": ["INSUFFICIENT_EVIDENCE", "INFERRED", "NEEDS_REINFERENCE", "null"]}
      }
    },
    "system_inference": {
      "type": "object", "additionalProperties": false,
      "required": ["confidence", "uncertainty", "confidence_band", "reason_codes", "contradiction_status"],
      "properties": {
        "confidence": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "uncertainty": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "confidence_band": {"enum": ["INSUFFICIENT", "LOW", "MODERATE", "HIGH", "null"]},
        "reason_codes": {"type": "array", "minItems": 1, "items": {"enum": ["INDEPENDENT_EVIDENCE_PRESENT", "ASSISTED_EVIDENCE_ONLY", "TRANSFER_EVIDENCE_PRESENT", "DELAYED_RETENTION_PRESENT", "EVIDENCE_STALE", "CONTRADICTORY_EVIDENCE", "MAPPING_PARTIAL", "LOW_TRUST_IMPORT", "INDEPENDENT_VERIFICATION_REQUIRED"]}, "uniqueItems": true},
        "contradiction_status": {"enum": ["NONE_OBSERVED", "PRESENT_REINFERENCE_REQUIRED", "PRESENT_VERIFICATION_RECOMMENDED", "UNKNOWN"]}
      },
      "description": "System confidence/uncertainty is a separate inference dimension and never aliases learner self-confidence."
    },
    "learner_self_confidence": {
      "type": ["object", "null"], "additionalProperties": false,
      "required": ["latest_value", "scale", "observed_at", "event_ref"],
      "properties": {"latest_value": {"type": ["number", "null"]}, "scale": {"type": ["string", "null"]}, "observed_at": {"type": ["string", "null"], "format": "date-time"}, "event_ref": {"type": ["string", "null"]}},
      "description": "Optional raw learner signal, retained only for calibration; it cannot establish mastery or system confidence."
    },
    "summary": {
      "type": "object", "additionalProperties": false,
      "required": ["accepted_event_count", "correct_count", "incorrect_count", "event_refs", "last_observed_at"],
      "properties": {"accepted_event_count": {"type": "integer", "minimum": 0}, "correct_count": {"type": "integer", "minimum": 0}, "incorrect_count": {"type": "integer", "minimum": 0}, "event_refs": {"type": "array", "items": {"type": "string"}}, "last_observed_at": {"type": ["string", "null"], "format": "date-time"}}
    },
    "evidence_summaries": {
      "type": "object", "additionalProperties": false,
      "required": ["independent", "assisted", "transfer", "retention", "contradictory"],
      "properties": {
        "independent": {"$ref": "#/$defs/summary"},
        "assisted": {"$ref": "#/$defs/summary"},
        "transfer": {"$ref": "#/$defs/summary"},
        "retention": {"$ref": "#/$defs/summary"},
        "contradictory": {"type": "object", "additionalProperties": false, "required": ["observed", "event_refs", "resolution"], "properties": {"observed": {"type": "boolean"}, "event_refs": {"type": "array", "items": {"type": "string"}}, "resolution": {"enum": ["NONE_NEEDED", "REINFERENCE_REQUIRED", "INDEPENDENT_VERIFICATION_REQUIRED"]}}}
      }
    },
    "evidence_position": {
      "type": "object", "additionalProperties": false,
      "required": ["semantic_mapping_versions"],
      "properties": {"server_watermark": {"type": "string", "minLength": 1}, "max_server_sequence": {"type": "integer", "minimum": 0}, "included_event_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "semantic_mapping_versions": {"type": "array", "minItems": 1, "items": {"type": "string"}}},
      "anyOf": [{"required": ["server_watermark"]}, {"required": ["max_server_sequence"]}, {"required": ["included_event_refs"]}]
    }
  },
  "x-policy": {
    "inference_policy_version": "mastery-inference-v0.1-transparent-no-final-coefficients",
    "policy_status": "PROVISIONAL_TRANSPARENT_CONTRACT_ONLY",
    "ordering_principle": ["independent_verification_or_delayed_retention", "unassisted_transfer", "unassisted_same_domain", "low_assistance_success", "high_assistance_success", "solution_exposed_completion"],
    "forbidden_inputs_as_canonical_mastery": ["raw_percent_correct", "product_mastered_flag", "tutor_statement", "learner_self_confidence", "client_authored_mastery"],
    "invariants": ["meaningful assistance normally requires a later independent verification", "contradictions increase uncertainty or trigger verification", "no final coefficient table is defined"]
  }
}
