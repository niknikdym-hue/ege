{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eksamio.ru/schemas/retention-schedule-state/0.1.0",
  "title": "Eksamio retention schedule and state",
  "description": "Retention is delayed evidence distinct from same-session repetition. Policies are replaceable and make no universal forgetting-curve claim.",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "schedule_policy", "state_schema", "calculation_contract"],
  "properties": {"schema_version": {"const": "0.1.0"}, "schedule_policy": {"$ref": "#/$defs/schedule_policy"}, "state_schema": {"$ref": "#/$defs/state"}, "calculation_contract": {"$ref": "#/$defs/calculation_contract"}},
  "$defs": {
    "schedule_policy": {"type": "object", "additionalProperties": false, "required": ["schedule_policy_version", "policy_status", "scientific_claim_boundary", "eligible_evidence_rule", "failure_policy"], "properties": {"schedule_policy_version": {"type": "string", "minLength": 1}, "policy_status": {"const": "PROVISIONAL_CONSERVATIVE_RULES_ONLY"}, "scientific_claim_boundary": {"const": "NO_UNIVERSAL_FORGETTING_CURVE_OR_CONSTANTS_CLAIMED"}, "eligible_evidence_rule": {"const": "A delayed check must have a different session_id than its qualifying evidence and a nonzero recorded delay."}, "failure_policy": {"const": "Retention failure appends evidence, triggers reinference and restabilization; it never deletes historical evidence."}}},
    "state": {"type": "object", "additionalProperties": false, "required": ["learner_profile_id", "subject_id", "semantic_id", "current_state", "last_delayed_check", "history", "schedule_policy_version", "source_evidence_refs", "next_due_calculation", "computed_at"], "properties": {"learner_profile_id": {"type": "string", "minLength": 3}, "subject_id": {"type": "string", "minLength": 2}, "semantic_id": {"type": "string", "minLength": 3}, "current_state": {"enum": ["NOT_ELIGIBLE_INSUFFICIENT_EVIDENCE", "SCHEDULED", "DUE", "OVERDUE", "RETAINED_AFTER_DELAYED_CHECK", "RETENTION_FAILURE_RESTABILIZATION_NEEDED"]}, "last_delayed_check": {"type": ["object", "null"], "additionalProperties": false, "required": ["event_ref", "checked_at", "outcome", "delay_seconds", "qualifying_event_ref", "qualifying_session_id", "check_session_id"], "properties": {"event_ref": {"type": "string"}, "checked_at": {"type": "string", "format": "date-time"}, "outcome": {"enum": ["CORRECT", "INCORRECT", "PARTIAL"]}, "delay_seconds": {"type": "integer", "minimum": 1}, "qualifying_event_ref": {"type": "string"}, "qualifying_session_id": {"type": "string"}, "check_session_id": {"type": "string"}}}, "history": {"type": "object", "additionalProperties": false, "required": ["previous_retention_successes", "previous_retention_failures", "event_refs"], "properties": {"previous_retention_successes": {"type": "integer", "minimum": 0}, "previous_retention_failures": {"type": "integer", "minimum": 0}, "event_refs": {"type": "array", "items": {"type": "string"}}}}, "schedule_policy_version": {"type": "string", "minLength": 1}, "source_evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "next_due_calculation": {"$ref": "#/$defs/calculation"}, "computed_at": {"type": "string", "format": "date-time"}}},
    "calculation_contract": {"type": "object", "additionalProperties": false, "required": ["allowed_inputs", "required_reason_codes", "forbidden_assumption"], "properties": {"allowed_inputs": {"type": "array", "minItems": 1, "items": {"enum": ["LAST_INDEPENDENT_VERIFICATION", "PREVIOUS_RETENTION_SUCCESSES", "PREVIOUS_RETENTION_FAILURES", "TIME_SINCE_VERIFICATION", "EVIDENCE_STABILITY", "ERROR_RECURRENCE", "GOAL_RELEVANCE", "AVAILABLE_REVIEW_CAPACITY"]}}, "required_reason_codes": {"type": "array", "items": {"enum": ["AWAITING_FIRST_DELAYED_CHECK", "SCHEDULED_AFTER_INDEPENDENT_VERIFICATION", "DUE_WINDOW_REACHED", "OVERDUE_WINDOW_PASSED", "RETAINED_AND_RESCHEDULED", "RETENTION_FAILURE_RESTABILIZE"]}}, "forbidden_assumption": {"const": "Same-session repetition is never recorded as delayed retention."}}},
    "calculation": {"type": "object", "additionalProperties": false, "required": ["scheduled_at", "due_window_start", "due_window_end", "input_refs", "reason_codes"], "properties": {"scheduled_at": {"type": ["string", "null"], "format": "date-time"}, "due_window_start": {"type": ["string", "null"], "format": "date-time"}, "due_window_end": {"type": ["string", "null"], "format": "date-time"}, "input_refs": {"type": "array", "items": {"type": "string"}}, "reason_codes": {"type": "array", "minItems": 1, "items": {"enum": ["AWAITING_FIRST_DELAYED_CHECK", "SCHEDULED_AFTER_INDEPENDENT_VERIFICATION", "DUE_WINDOW_REACHED", "OVERDUE_WINDOW_PASSED", "RETAINED_AND_RESCHEDULED", "RETENTION_FAILURE_RESTABILIZE"]}}}}
  },
  "x-policy": {"schedule_policy_version": "retention-schedule-v0.1-conservative-no-curve", "same_session_repetition_is_retention": false, "retention_failure_deletes_history": false}
}
