# Non-secret staging resource identifiers only. Never commit real secret payloads.
YC_FOLDER_ID=
YC_CONTAINER_ID=
YC_CONTAINER_NAME=eksamio-peis-staging
YC_RUNTIME_SA_ID=
YC_GATEWAY_SA_ID=
YC_GATEWAY_NAME=eksamio-peis-staging
YC_NETWORK_ID=
YC_IMAGE=cr.yandex/<registry-id>/eksamio-peis@sha256:<immutable-digest>

# Shared canonical PostgreSQL DSN from Lockbox.
YC_DB_SECRET_ID=
YC_DB_SECRET_VERSION_ID=
YC_DB_SECRET_KEY=dsn

# Identity HMAC/signing material is referenced from Lockbox, never stored here.
YC_IDENTITY_SECRET_ID=
YC_IDENTITY_SECRET_VERSION_ID=
YC_IDENTITY_CONTACT_HMAC_KEY=contact_hmac
YC_IDENTITY_VERIFICATION_HMAC_KEY=verification_hmac
YC_IDENTITY_HOST_SIGNING_KEY=host_signing

# Exact browser origin and verified Postbox sender are configuration, not secrets.
EKSAMIO_ALLOWED_ORIGIN=https://eksamio.ru
EKSAMIO_POSTBOX_SENDER=

# Fail closed. Enabling real registration delivery requires a separate owner gate.
PEIS_NETWORK_WRITES_ENABLED=false
EKSAMIO_WEB_IDENTITY_REQUIRED=false
EKSAMIO_REGISTRATION_BEGIN_ENABLED=false
EKSAMIO_POSTBOX_EXECUTION_ENABLED=false
EKSAMIO_EXTERNAL_DELIVERY_AUTHORIZED=false
YC_GATEWAY_APPLY=false
