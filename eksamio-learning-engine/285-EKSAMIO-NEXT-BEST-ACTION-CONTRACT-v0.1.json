{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eksamio.ru/schemas/next-best-action/0.1.0",
  "title": "Eksamio subject-agnostic Next Best Action recommendation",
  "description": "A versioned, explainable proposal selected from structured evidence/state. It is not canonical mastery truth and is not engagement optimization.",
  "type": "object", "additionalProperties": false,
  "required": ["recommendation_id", "learner_profile_id", "subject_id", "action_type", "semantic_targets", "reason_codes", "priority", "estimated_minutes", "route", "verification_required", "created_at", "nba_policy_version", "learner_state_watermark", "source_goal_context_refs"],
  "properties": {
    "recommendation_id": {"type": "string", "minLength": 8}, "learner_profile_id": {"type": "string", "minLength": 3}, "subject_id": {"type": "string", "minLength": 2},
    "action_type": {"enum": ["DIAGNOSE_TARGET", "VERIFY_UNCERTAIN_STATE", "LEARN_PREREQUISITE", "EXPLAIN_RULE_OR_CONCEPT", "GUIDED_PRACTICE", "INDEPENDENT_PRACTICE", "TRANSFER_CHECK", "RETENTION_REVIEW", "EXAM_CONTROL_RECHECK", "HOMEWORK_FOLLOWUP", "ESSAY_REPAIR_REWRITE", "MOVE_TO_NEXT_TARGET", "STOP_SESSION_COMPLETE"]},
    "semantic_targets": {"type": "array", "items": {"type": "string", "minLength": 3}}, "prerequisite_targets": {"type": "array", "items": {"type": "string", "minLength": 3}},
    "reason_codes": {"type": "array", "minItems": 1, "items": {"enum": ["LOW_MASTERY_HIGH_CONFIDENCE", "PREREQUISITE_BLOCKS_TARGET", "PREREQUISITE_REPAIR_FOR_ORIGINAL_GOAL", "STATE_UNCERTAIN_NEEDS_DIAGNOSTIC", "STALE_EVIDENCE_NEEDS_VERIFICATION", "CONTRADICTORY_EVIDENCE_NEEDS_VERIFICATION", "INDEPENDENT_VERIFICATION_REQUIRED_AFTER_HELP", "TRANSFER_NOT_YET_VERIFIED", "RETENTION_DUE", "RETENTION_OVERDUE", "RETENTION_FAILURE_RESTABILIZE", "HIGH_VALUE_EXAM_GAP", "EXAM_DATE_URGENCY", "HOMEWORK_URGENT", "TARGET_READY_TO_LEARN", "ALREADY_STRONG_RETAINED", "NO_MEANINGFUL_WORK_IN_SESSION"]}, "uniqueItems": true},
    "priority": {"type": "object", "additionalProperties": false, "required": ["band", "policy_inputs_used"], "properties": {"band": {"enum": ["LOW", "NORMAL", "HIGH", "URGENT"]}, "policy_inputs_used": {"type": "array", "minItems": 1, "items": {"enum": ["LEARNER_GOAL", "EXAM_DATE_CONTEXT", "MASTERY_ESTIMATE", "SYSTEM_CONFIDENCE", "READINESS", "RETENTION_STATE", "RECENT_ERRORS", "ASSISTANCE_DEPENDENCE", "CONTENT_AVAILABILITY", "ESTIMATED_DURATION", "SESSION_TIME_BUDGET", "EXAM_RELEVANCE", "PRIOR_OUTCOME"]}}}},
    "estimated_minutes": {"type": ["integer", "null"], "minimum": 1}, "route": {"type": "object", "additionalProperties": false, "required": ["product_or_mode", "content_refs"], "properties": {"product_or_mode": {"type": ["string", "null"]}, "content_refs": {"type": "array", "items": {"type": "string"}}}},
    "verification_required": {"type": "boolean"}, "created_at": {"type": "string", "format": "date-time"}, "expires_at": {"type": ["string", "null"], "format": "date-time"}, "nba_policy_version": {"type": "string", "minLength": 1}, "learner_state_watermark": {"type": "string", "minLength": 1}, "source_goal_context_refs": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "outcome_event": {"type": "object", "additionalProperties": false, "required": ["outcome_event_id", "recommendation_id", "event_type", "occurred_at", "outcome_log_policy_version"], "properties": {"outcome_event_id": {"type": "string", "minLength": 8}, "recommendation_id": {"type": "string", "minLength": 8}, "event_type": {"enum": ["SHOWN", "ACCEPTED", "SKIPPED", "COMPLETED", "ABANDONED", "SUBSEQUENT_INDEPENDENT_SUCCESS", "SUBSEQUENT_INDEPENDENT_FAILURE", "SUBSEQUENT_TRANSFER_SUCCESS", "SUBSEQUENT_TRANSFER_FAILURE", "SUBSEQUENT_RETENTION_SUCCESS", "SUBSEQUENT_RETENTION_FAILURE"]}, "occurred_at": {"type": "string", "format": "date-time"}, "outcome_log_policy_version": {"type": "string", "minLength": 1}, "evidence_event_refs": {"type": "array", "items": {"type": "string"}}, "notes": {"type": ["string", "null"]}}}
  },
  "x-policy": {
    "nba_policy_version": "nba-v0.1-transparent-guardrails",
    "primary_objective": "maximize_expected_educational_value_for_learner_goal_under_time_content_and_readiness_constraints",
    "explicitly_not_optimized_for": ["chat_length", "clicks", "voice_minutes", "session_length", "engagement_as_primary_objective"],
    "policy_shape": "Transparent ordered guardrails and declared priority bands; no opaque final score or client magic constant.",
    "outcome_logging_contract": {"schema_ref": "#/$defs/outcome_event", "events_required": ["SHOWN", "ACCEPTED", "SKIPPED", "COMPLETED", "ABANDONED", "SUBSEQUENT_INDEPENDENT_SUCCESS", "SUBSEQUENT_INDEPENDENT_FAILURE", "SUBSEQUENT_TRANSFER_SUCCESS", "SUBSEQUENT_TRANSFER_FAILURE", "SUBSEQUENT_RETENTION_SUCCESS", "SUBSEQUENT_RETENTION_FAILURE"], "invariant": "Outcomes are evaluative data and do not mutate canonical mastery unless linked valid learner evidence is separately accepted."},
    "ai_boundary": "AI or Tutor may emit a structured candidate; only the policy engine writes a recommendation proposal and neither writes canonical learner truth directly."
  },
  "x-validation_fixtures": [
    {"fixture_id": "S01-low-mastery-high-confidence", "subject_id": "russian", "target": "fixture-russian-target-01", "flags": ["LOW_MASTERY_HIGH_CONFIDENCE", "READY"], "expected_action_type": "GUIDED_PRACTICE", "expected_reason_codes": ["LOW_MASTERY_HIGH_CONFIDENCE", "TARGET_READY_TO_LEARN"]},
    {"fixture_id": "S02-required-prerequisite-gap", "subject_id": "russian", "target": "fixture-russian-target-02", "prerequisite_target": "fixture-russian-prerequisite-02", "flags": ["REQUIRED_PREREQUISITE_GAP"], "expected_action_type": "LEARN_PREREQUISITE", "expected_reason_codes": ["PREREQUISITE_BLOCKS_TARGET", "PREREQUISITE_REPAIR_FOR_ORIGINAL_GOAL"]},
    {"fixture_id": "S03-strong-but-stale-low-confidence", "subject_id": "russian", "target": "fixture-russian-target-03", "flags": ["STALE_OR_LOW_CONFIDENCE"], "expected_action_type": "VERIFY_UNCERTAIN_STATE", "expected_reason_codes": ["STALE_EVIDENCE_NEEDS_VERIFICATION"]},
    {"fixture_id": "S04-assisted-tutor-success", "subject_id": "russian", "target": "fixture-russian-target-04", "flags": ["MEANINGFUL_ASSISTANCE_WITHOUT_INDEPENDENT_CHECK"], "expected_action_type": "INDEPENDENT_PRACTICE", "expected_reason_codes": ["INDEPENDENT_VERIFICATION_REQUIRED_AFTER_HELP"]},
    {"fixture_id": "S05-independent-success-no-delayed-evidence", "subject_id": "russian", "target": "fixture-russian-target-05", "flags": ["INDEPENDENT_SUCCESS_NO_DELAYED_EVIDENCE"], "expected_action_type": "RETENTION_REVIEW", "expected_reason_codes": ["RETENTION_DUE"]},
    {"fixture_id": "S06-retention-failure-restabilization", "subject_id": "russian", "target": "fixture-russian-target-06", "flags": ["RETENTION_FAILURE_HISTORY_PRESERVED"], "expected_action_type": "GUIDED_PRACTICE", "expected_reason_codes": ["RETENTION_FAILURE_RESTABILIZE"]},
    {"fixture_id": "S07-conflicting-evidence", "subject_id": "russian", "target": "fixture-russian-target-07", "flags": ["CONTRADICTORY_EVIDENCE"], "expected_action_type": "VERIFY_UNCERTAIN_STATE", "expected_reason_codes": ["CONTRADICTORY_EVIDENCE_NEEDS_VERIFICATION"]},
    {"fixture_id": "S08-near-exam-high-value-gap", "subject_id": "russian", "target": "fixture-russian-target-08", "flags": ["LOW_MASTERY_HIGH_CONFIDENCE", "READY", "HIGH_VALUE_EXAM_GAP", "EXAM_DATE_URGENT"], "expected_action_type": "GUIDED_PRACTICE", "expected_reason_codes": ["LOW_MASTERY_HIGH_CONFIDENCE", "TARGET_READY_TO_LEARN", "HIGH_VALUE_EXAM_GAP", "EXAM_DATE_URGENCY"]},
    {"fixture_id": "S09-homework-urgent-prerequisite-gap", "subject_id": "russian", "target": "fixture-russian-target-09", "prerequisite_target": "fixture-russian-prerequisite-09", "flags": ["REQUIRED_PREREQUISITE_GAP", "HOMEWORK_URGENT"], "expected_action_type": "LEARN_PREREQUISITE", "expected_reason_codes": ["PREREQUISITE_BLOCKS_TARGET", "PREREQUISITE_REPAIR_FOR_ORIGINAL_GOAL", "HOMEWORK_URGENT"]},
    {"fixture_id": "S10-mastered-retained", "subject_id": "russian", "target": "fixture-russian-target-10", "flags": ["ALREADY_STRONG_RETAINED"], "expected_action_type": "MOVE_TO_NEXT_TARGET", "expected_reason_codes": ["ALREADY_STRONG_RETAINED"]},
    {"fixture_id": "S11-no-meaningful-work", "subject_id": "russian", "target": "fixture-russian-target-11", "flags": ["NO_MEANINGFUL_WORK"], "expected_action_type": "STOP_SESSION_COMPLETE", "expected_reason_codes": ["NO_MEANINGFUL_WORK_IN_SESSION"]},
    {"fixture_id": "S12-mathematics-structural", "subject_id": "mathematics", "target": "fixture-mathematics-target-12", "flags": ["STALE_OR_LOW_CONFIDENCE"], "expected_action_type": "VERIFY_UNCERTAIN_STATE", "expected_reason_codes": ["STALE_EVIDENCE_NEEDS_VERIFICATION"], "fixture_scope": "STRUCTURAL_ONLY_NO_SUBJECT_TRUTH"}
  ]
}
