{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eksamio.ru/schemas/prerequisite-readiness/0.1.0",
  "title": "Eksamio source-backed prerequisite graph and readiness state",
  "description": "A versioned graph contract plus recomputable learner readiness. Course order and AI assertions are never graph truth.",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "graph_contract", "readiness_contract"],
  "properties": {"schema_version": {"const": "0.1.0"}, "graph_contract": {"$ref": "#/$defs/graph_contract"}, "readiness_contract": {"$ref": "#/$defs/readiness_contract"}},
  "$defs": {
    "graph_contract": {
      "type": "object", "additionalProperties": false,
      "required": ["graph_version", "edge_schema", "admission_policy", "canonical_edges"],
      "properties": {
        "graph_version": {"type": "string", "minLength": 1},
        "edge_schema": {"$ref": "#/$defs/edge_schema"},
        "admission_policy": {"type": "object", "additionalProperties": false, "required": ["required_provenance", "required_review_statuses_for_canonical_use", "forbidden_edge_sources"], "properties": {"required_provenance": {"const": true}, "required_review_statuses_for_canonical_use": {"type": "array", "items": {"enum": ["SOURCE_VERIFIED", "ACCEPTED"]}, "minItems": 1}, "forbidden_edge_sources": {"type": "array", "items": {"enum": ["COURSE_ORDER_ALONE", "EXAM_TASK_ORDER_ALONE", "AI_ASSERTION_ALONE"]}, "minItems": 3}}},
        "canonical_edges": {"type": "array", "items": {"$ref": "#/$defs/edge"}, "description": "Empty until source-reviewed graph edges are admitted; this task intentionally creates no subject-truth edge."}
      }
    },
    "edge_schema": {"type": "object", "additionalProperties": false, "required": ["source_semantic_id", "target_semantic_id", "relation_type", "provenance", "graph_version", "review_status", "admission_scope"], "properties": {"source_semantic_id": {"type": "string", "minLength": 3}, "target_semantic_id": {"type": "string", "minLength": 3}, "relation_type": {"enum": ["REQUIRED", "RECOMMENDED", "SUPPORTS"]}, "provenance": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/provenance"}}, "graph_version": {"type": "string", "minLength": 1}, "review_status": {"enum": ["PENDING_REVIEW", "SOURCE_VERIFIED", "ACCEPTED", "REJECTED"]}, "conditional_scope": {"type": ["object", "null"], "additionalProperties": false, "properties": {"subject_id": {"type": "string"}, "goal_context": {"type": "string"}, "route_context": {"type": "string"}}}, "admission_scope": {"enum": ["CANONICAL_GRAPH", "TEST_FIXTURE_ONLY"]}}},
    "edge": {"$ref": "#/$defs/edge_schema"},
    "provenance": {"type": "object", "additionalProperties": false, "required": ["source_ref", "source_locator", "assertion_type"], "properties": {"source_ref": {"type": "string", "minLength": 3}, "source_locator": {"type": "string", "minLength": 1}, "assertion_type": {"enum": ["VERIFIED_SUBJECT_SOURCE", "REVIEWED_CURRICULUM_SOURCE", "TEST_FIXTURE_NON_CANONICAL"]}}},
    "readiness_contract": {
      "type": "object", "additionalProperties": false,
      "required": ["readiness_policy_version", "state_schema", "statuses", "decision_invariants"],
      "properties": {
        "readiness_policy_version": {"type": "string", "minLength": 1},
        "statuses": {"type": "array", "uniqueItems": true, "items": {"enum": ["READY_TO_LEARN_OR_PRACTICE", "BLOCKED_BY_REQUIRED_PREREQUISITE", "INSUFFICIENT_EVIDENCE", "NEEDS_VERIFICATION", "ALREADY_STRONG_NOT_CURRENT_PRIORITY", "CONTENT_UNAVAILABLE"]}},
        "decision_invariants": {"type": "array", "minItems": 1, "items": {"enum": ["REQUIRED_EDGE_MUST_BE_CANONICAL_AND_SOURCE_REVIEWED_TO_BLOCK", "STALE_OR_CONTRADICTORY_EVIDENCE_REQUIRES_VERIFICATION", "COURSE_ORDER_IS_NOT_A_PREREQUISITE", "AI_CANNOT_ADMIT_EDGE"]}},
        "state_schema": {"$ref": "#/$defs/readiness_state"}
      }
    },
    "readiness_state": {"type": "object", "additionalProperties": false, "required": ["learner_profile_id", "subject_id", "target_semantic_id", "semantic_registry_version", "prerequisite_graph_version", "readiness_policy_version", "status", "required_prerequisite_assessments", "evidence_refs", "computed_at", "evidence_watermark"], "properties": {"learner_profile_id": {"type": "string", "minLength": 3}, "subject_id": {"type": "string", "minLength": 2}, "target_semantic_id": {"type": "string", "minLength": 3}, "semantic_registry_version": {"type": "string", "minLength": 1}, "prerequisite_graph_version": {"type": "string", "minLength": 1}, "readiness_policy_version": {"type": "string", "minLength": 1}, "status": {"enum": ["READY_TO_LEARN_OR_PRACTICE", "BLOCKED_BY_REQUIRED_PREREQUISITE", "INSUFFICIENT_EVIDENCE", "NEEDS_VERIFICATION", "ALREADY_STRONG_NOT_CURRENT_PRIORITY", "CONTENT_UNAVAILABLE"]}, "required_prerequisite_assessments": {"type": "array", "items": {"$ref": "#/$defs/prerequisite_assessment"}}, "evidence_refs": {"type": "array", "items": {"type": "string"}}, "computed_at": {"type": "string", "format": "date-time"}, "evidence_watermark": {"type": "string", "minLength": 1}, "original_goal_ref": {"type": ["string", "null"]}}},
    "prerequisite_assessment": {"type": "object", "additionalProperties": false, "required": ["edge_ref", "relation_type", "state", "confidence_band", "basis_evidence_refs"], "properties": {"edge_ref": {"type": "string", "minLength": 3}, "relation_type": {"enum": ["REQUIRED", "RECOMMENDED", "SUPPORTS"]}, "state": {"enum": ["MET", "GAP_CONFIRMED", "UNKNOWN", "STALE_OR_CONTRADICTORY"]}, "confidence_band": {"enum": ["INSUFFICIENT", "LOW", "MODERATE", "HIGH"]}, "basis_evidence_refs": {"type": "array", "items": {"type": "string"}}}}
  },
  "x-policy": {"graph_version": "prerequisite-graph-v0.1-empty-until-source-admission", "canonical_edge_count": 0, "no_subject_edges_created": true, "fixture_policy": "Structural validation may use synthetic TEST_FIXTURE_ONLY relations with explicit non-canonical provenance; they are never written into canonical_edges or used in production."}
}
