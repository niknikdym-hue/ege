   (root/'tests'/'test_browser.py').write_bytes(unpack(BROWSER_PAYLOAD))
    print(root)

def source_register(root:Path):
    docs=[]
    for f in sorted((root/'source').glob('*.pdf')):
        out=subprocess.check_output(['pdfinfo',str(f)],text=True,errors='replace')
        pages=next(int(x.split(':',1)[1]) for x in out.splitlines() if x.startswith('Pages:'))
        docs.append({'file':f.name,'bytes':f.stat().st_size,'sha256':hashlib.sha256(f.read_bytes()).hexdigest(),'physical_pdf_pages':pages,'authority':'ФГБНУ ФИПИ','source_year':2026})
    (root/f'{PREFIX}-SOURCE-REGISTER.json').write_text(json.dumps({'subject':'История','official_documents':docs,'repository_source_path':'istoriya-source-2026'},ensure_ascii=False,indent=2),encoding='utf-8')

def manifest(root:Path):
    rows=[]
    for f in sorted(root.rglob('*')):
        if f.is_file() and f.name!=f'{PREFIX}-MANIFEST.txt':
            rows.append(f'{f.relative_to(root)}\t{f.stat().st_size}\t{hashlib.sha256(f.read_bytes()).hexdigest()}')
    (root/f'{PREFIX}-MANIFEST.txt').write_text('PATH\tBYTES\tSHA256\n'+'\n'.join(rows)+'\n',encoding='utf-8')

def finalize(clean_pass:bool):
    root=Path.cwd()/NAME
    browser=json.loads((root/f'{PREFIX}-BROWSER-TEST-EVIDENCE.json').read_text(encoding='utf-8'))
    source_register(root)
    audit='''НЕЗАВИСИМЫЙ СОДЕРЖАТЕЛЬНЫЙ АУДИТ

