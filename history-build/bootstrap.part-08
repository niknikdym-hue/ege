'
BROWSER_PAYLOAD=''
NAME="ege-istoriya-demoversiya-v1"
PREFIX="ege-istoriya-demoversiya"

def unpack(payload:str)->bytes:
    return gzip.decompress(base64.b64decode(payload))

def build_package():
    tmp=Path('/tmp/history-build-package.py')
    tmp.write_bytes(unpack(BUILD_PAYLOAD))
    subprocess.run([sys.executable,str(tmp)],check=True)
    root=Path('/mnt/data')/NAME
    (root/'tests').mkdir(parents=True,exist_ok=True)
 